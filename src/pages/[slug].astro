---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PhotoSwipeGallery from '../components/PhotoSwipeGallery.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug }, // use the auto‑generated slug
    props: { project },
  }));
}

const base = import.meta.env.BASE_URL;
const { project } = Astro.props;
const renderedContent = project.render ? await project.render() : null;

// Retrieve all projects to create navigation links.
const allProjects = await getCollection('projects');
const currentIndex = allProjects.findIndex((p) => p.slug === project.slug);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;
---
<Layout>
  <nav class="project-nav container">
    <a class="nav-home" href={base}>Home</a>
    <div class="nav-links">
      {prevProject && (
        <a class="nav-prev" href={`${base}${prevProject.slug}/`}>
          ← {prevProject.data.title}
        </a>
      )}
      {nextProject && (
        <a class="nav-next" href={`${base}${nextProject.slug}/`}>
          {nextProject.data.title} →
        </a>
      )}
    </div>
  </nav>

  <div class="project-details container">
    <header class="project-header">
      <h1 class="project-title">{project.data.title}</h1>
      {project.data.description && (
        <p class="project-description">{project.data.description}</p>
      )}
    </header>

    {renderedContent ? (
      <article class="project-content">
        <renderedContent.Content />
      </article>
    ) : (
      <p>Loading...</p>
    )}

    {project.data.images?.length ? (
      <PhotoSwipeGallery
        images={project.data.images.map(({ image, caption }) => ({
          src: image, // image is a URL string
          caption,
          width: 1200,
          height: 800,
        }))}
      />
    ) : null}
  </div>
</Layout>
---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const renderedContent = project.render ? await project.render() : null;

// Retrieve all projects to create navigation links.
const allProjects = await getCollection('projects');
// Determine the index of the current project.
const currentIndex = allProjects.findIndex((p) => p.slug === project.slug);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject =
  currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;
---

<Layout>
  <nav class="project-nav container">
    <a class="nav-home" href={import.meta.env.BASE_URL}>Home</a>
    {prevProject && (
      <a class="nav-prev" href={`${import.meta.env.BASE_URL}${prevProject.slug}/`}>
        ← {prevProject.data.title}
      </a>
    )}
    {nextProject && (
      <a class="nav-next" href={`${import.meta.env.BASE_URL}${nextProject.slug}/`}>
        {nextProject.data.title} →
      </a>
    )}
  </nav>

  <div class="project-details container">
    <h1>{project.data.title}</h1>
    {project.data.description && (
      <p class="project-description">{project.data.description}</p>
    )}

    {renderedContent ? (
      <article class="project-content">
        <renderedContent.Content />
      </article>
    ) : (
      <p>Loading...</p>
    )}

    {project.data.images?.length ? (
      <section class="project-images">
        {project.data.images.map(({ image, caption }, index) => (
          <figure key={index}>
            <img
              src={image.src}
              alt={caption ?? "Project image"}
            />
            {caption && <figcaption>{caption}</figcaption>}
          </figure>
        ))}
      </section>
    ) : null}
  </div>
</Layout>
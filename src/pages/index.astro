---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout>
  <!-- Hero Section with a large background image -->
  <section class="hero">
    <!-- Replace '/images/hero.jpg' with your actual hero image file -->
    <img src="/images/hero.jpg" alt="Stunning interior design" />
    <div class="hero-overlay">
      <h1>Welcome to My Interior Design Portfolio</h1>
      <p>Explore exquisite projects crafted with elegance and earth tones.</p>
    </div>
  </section>

  <!-- Projects List Section -->
  <section class="landing">
    <h2>Featured Projects</h2>
    {projects.length === 0 ? (
      <p>No projects found. Check back later!</p>
    ) : (
      <ul>
        {projects.map((project) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}${project.slug}/`}>
              {project.data.title}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
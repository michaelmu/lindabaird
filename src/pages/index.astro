---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---
<Layout>
  <div class="index-page">
    <section class="hero">
      <img src={`images/front1.jpg`} alt="Stunning interior design" />
      <div class="hero-overlay">
        <h1>Japanese-inspired interior design</h1>
        <p>Explore exquisite projects crafted with elegance and earth tones.</p>
      </div>
    </section>

    <!-- Projects List Section -->
    <section class="landing">
      <div class="index-page-projects">
        <h2>Featured Projects</h2>
        <ul>
          <li>
			<h3>Nature Suite</h3>
            <a href={`${base}projects/nature-suite`}>
				<Image width={300} height={200} class="rounded-lg object-cover" src={`${base}src/assets/projects/nature-suite/01-living-room.jpg`} alt="Nature Suite" />
			</a>
          </li>
        </ul>
		<ul>
			<li>
				<h3>Pacific Northwest Midcentury Modern</h3>
			  <a href={`${base}projects/pacific-northwest-midcentury-modern`}>
			  <Image width={300} height={200} class="rounded-lg object-cover" src={`${base}src/assets/projects/pacific-northwest-midcentury-modern/pacific-northwest-midcentury-modern-01.jpg`} alt="Pacific Northwest Midcentury Modern" />
			</a>
			</li>
		  </ul>
      </div>
    </section>
  </div>
</Layout>

<Footer />
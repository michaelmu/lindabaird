---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
const base = import.meta.env.BASE_URL;
---
<Layout>
  <div class="index-page">
    <section class="hero">
      <img src={`images/front1.jpg`} alt="Stunning interior design" />
      <div class="hero-overlay">
        <h1>Japanese-inspired interior design</h1>
        <p>Explore exquisite projects crafted with elegance and earth tones.</p>
      </div>
    </section>

    <!-- Projects List Section -->
    <section class="landing">
		<div class="featured-projects">
			<article class="featured-project-card">
				<a href="projects/pacific-northwest-midcentury-modern">
				  <Image src="/src/assets/projects/pacific-northwest-midcentury-modern/pacific-northwest-midcentury-modern-01.jpg" width={300} height={200} alt="Pacific Northwest Midcentury Modern" />
				  <div class="featured-project-overlay">
					<h3>Pacific Northwest Midcentury Modern</h3>
					<p>Experience timeless design with a modern twist.</p>
				  </div>
				</a>
			  </article>
			<article class="featured-project-card">
				<a href="projects/nature-suite">
				<Image src="/src/assets/projects/nature-suite/01-living-room.jpg" width={300} height={200} alt="Nature Suite" />
			  <div class="featured-project-overlay">
				<h3>Nature Suite</h3>
				<p>Discover modern elegance inspired by nature.</p>
			  </div>
			</a>
		  </article>
		  <article class="featured-project-card">
			<a href="projects/harbor-view">
				<Image src="/src/assets/projects/harbor-view/emilykeeney.linda-joy.8.12.22-58.jpg" width={300} height={200} alt="Harbor View" />
			  <div class="featured-project-overlay">
				<h3>Harbor View</h3>
				<p>Experience timeless design with a modern twist.</p>
			  </div>
			</a>
		  </article>
		  
		</div>
	  </section>
  </div>
</Layout>

<Footer />
---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

interface Props {
  project: string;
}

const { project } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/**/*.{jpg,jpeg,png}'
);
const imagePaths = Object.keys(images).filter((path) =>
  path.includes(`../assets/projects/${project}/`)
);
---
<div id="gallery" class="gallery">
  {
    imagePaths.map(async (imagePath) => {
      const imageModule = await images[imagePath]();
      const image = imageModule.default;
      const optimizedImage = await getImage({
        src: image,
        width: 1920,
      });
      const alt = imagePath
        .split("/")
        .pop()
        ?.replace(/[-_]/g, " ")
        .replace(/\.[^.]+$/, "");

      return (
        <a
          href={optimizedImage.src}
          data-pswp-width={optimizedImage.attributes.width}
          data-pswp-height={optimizedImage.attributes.height}
        >
          <Image src={image} alt={alt} height={350} loading="lazy" />
        </a>
      );
    })
  }
</div>

<script>
	import PhotoSwipeLightbox from "photoswipe/lightbox";
	import "photoswipe/style.css";

	const lightbox = new PhotoSwipeLightbox({
		gallery: "#gallery",
		children: "a",
		pswpModule: () => import("photoswipe"),
	});

	lightbox.init();
</script>

<style>
  /* Responsive image grid within project-content */
  .gallery {
    display: grid;
    /* Auto-fit as many columns as will fit, min width 300px, flex to fill */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    width: 100%;
  }
  /* Make each link (grid item) fill its cell */
  .gallery a {
    display: block;
    width: 100%;
  }
  /* Ensure images scale to cell width and maintain aspect ratio */
  .gallery img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
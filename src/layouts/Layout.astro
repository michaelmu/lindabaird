---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// src/layouts/Layout.astro
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <!-- Global Styles -->
    <link rel="stylesheet" href={`${base}styles/global.css`} />
    <!-- (Optional) Include your custom fonts if self-hosted or via a service -->
    <!-- For example: -->
    <!-- <link rel="stylesheet" href="https://yourfontprovider.com/avenirbook.css" /> -->
    <!-- <link rel="stylesheet" href="https://yourfontprovider.com/butlerregular.css" /> -->
    <title>{Astro.props.title || "Linda Baird Design"}</title>
    <base href={base} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
